# ==========================================================================
# Py 书斋 PyShelf —— Git 忽略规则
# 项目性质：纯 Python + tkinter 桌面应用（依赖 PyMuPDF / Pillow 运行时环境）
# ==========================================================================

# ---------------------------- Python 编译产物 ----------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.egg
*.egg-info/
.eggs/

# ---------------------------- 虚拟环境 / 包管理 --------------------------
.venv/
venv/
env/
ENV/
.conda/
pip-log.txt
pip-delete-this-directory.txt

# ---------------------------- 打包 / 构建产物 ----------------------------
build/
dist/
*.spec
*.manifest

# ---------------------------- 测试与静态检查缓存 -------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---------------------------- 应用运行时数据（勿入库） -------------------
# data/ 由程序运行时生成，且含不宜公开的本地信息：
#   library.json   记录本地书籍绝对路径、每本书阅读进度（暴露个人目录结构）
#   covers/*.png   由本地 PDF 首页渲染的封面（受版权保护内容的衍生物）
#   settings.json  本机设置，可能含 GitHub Token 等凭据
#   crash.log      未捕获异常日志
# 如需在仓库中说明数据结构，请另建 data.example/ 存放脱敏样例。
data/

# ---------------------------- 开发调试临时产物 ---------------------------
# app.py 的 --shot / --shotsrc 自截窗口图，以及下划线开头的临时排查/回归脚本
_shot*.png
_reader_shot*.png
_screen.png
_*.py
*.part

# ---------------------------- 日志 ----------------------------
*.log

# ---------------------------- 操作系统与编辑器 ---------------------------
Thumbs.db
ehthumbs.db
desktop.ini
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
._*

.idea/
.vscode/
*.swp
*.swo
*~

# ---------------------------- 本地个人配置（若日后新增） -----------------
# 保留：app.ico（应用图标，必须入库）、launcher.bat（启动脚本，必须入库）
*.local.json
.env
.env.*
